generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  position  String
  team      String?
  college   String?
  sleeperId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases       PlayerAlias[]
  values        PlayerValue[]
  weeklyStats   PlayerWeeklyStats[]
  votesAsA      MatchupVote[] @relation("PlayerA")
  votesAsB      MatchupVote[] @relation("PlayerB")
  votesAsWinner MatchupVote[] @relation("Winner")

  @@map("players")
}

// Alternate names a player may be imported/searched under (e.g. "Pat Mahomes").
model PlayerAlias {
  id       Int    @id @default(autoincrement())
  playerId Int
  alias    String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, alias])
  @@map("player_aliases")
}

// One per ranking week. PlayerValue rows are grouped under a snapshot so
// past weeks are never overwritten when values change.
model RankingSnapshot {
  id        Int      @id @default(autoincrement())
  season    Int
  week      Int
  label     String
  notes     String?
  createdAt DateTime @default(now())

  values PlayerValue[]

  @@unique([season, week])
  @@map("ranking_snapshots")
}

model PlayerValue {
  id         Int      @id @default(autoincrement())
  playerId   Int
  snapshotId Int
  source     String   // "fantasycalc" | "keeptradecut" | "manual"
  format     String   // "halfppr_1qb" | "ppr_1qb" | ... | "all" (manual overrides)
  value      Int
  createdAt  DateTime @default(now())

  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  snapshot RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([playerId, snapshotId, source, format])
  @@map("player_values")
}

model PlayerWeeklyStats {
  id         Int      @id @default(autoincrement())
  playerId   Int
  season     Int
  week       Int
  seasonType String   @default("regular") // "pre" | "regular"
  ptsStd     Float?
  ptsHalfPpr Float?
  ptsPpr     Float?
  passYd     Int?
  passTd     Int?
  passInt    Int?
  rushYd     Int?
  rushTd     Int?
  rec        Int?
  recYd      Int?
  recTd      Int?
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week, seasonType])
  @@map("player_weekly_stats")
}

model MatchupVote {
  id        Int      @id @default(autoincrement())
  playerAId Int
  playerBId Int
  winnerId  Int
  format    String   @default("halfppr_1qb")
  createdAt DateTime @default(now())

  playerA Player @relation("PlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB Player @relation("PlayerB", fields: [playerBId], references: [id], onDelete: Cascade)
  winner  Player @relation("Winner", fields: [winnerId], references: [id], onDelete: Cascade)

  @@map("matchup_votes")
}

// Reserved for future bulk/CSV/API imports of players or values. Not yet
// wired to any UI in V1.
model ImportRun {
  id         Int       @id @default(autoincrement())
  source     String
  status     String
  summary    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@map("import_runs")
}
